Rscript 1.1.1.2_bivgausscopula_t4t10margs_gamma1_0.5_gamma2_0.67_bootmargs_cooleysmoothpercoord.R --save_full_path "$FULL_SAVE_PATH" --save_df_path "$DF_SAVE_PATH" --n_cores 64