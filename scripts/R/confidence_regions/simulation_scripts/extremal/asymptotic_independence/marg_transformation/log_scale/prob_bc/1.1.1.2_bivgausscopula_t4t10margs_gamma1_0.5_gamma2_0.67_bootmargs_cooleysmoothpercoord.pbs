#!/bin/bash -l

#SBATCH -A dasrepo
#SBATCH --job-name=1.1.1.2_bivgausscopula_t4t10margs_gamma1_0.5_gamma2_0.67_bootmargs_cooleysmoothpercoord
#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --output=1.1.1.2_bivgausscopula_t4t10margs_gamma1_0.5_gamma2_0.67_bootmargs_cooleysmoothpercoord%j.out
