#!/bin/bash -l

#SBATCH -A dasrepo
#SBATCH --job-name=extreme_coverage_simulations_threeway_isobootsurv
#SBATCH --time=06:00:00
#SBATCH --nodes=1
#SBATCH --output=./logs/extreme_coverage_simulations_threeway_isobootsurv%j.out
#SBATCH --error=./logs/extreme_coverage_simulations_threeway_isobootsurv%j.err
#SBATCH --exclusive
#SBATCH -q regular
#SBATCH --ntasks-per-node=64
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=butlerj@berkeley.edu
#SBATCH --constraint=cpu

cd ..
cd R
cd confidence_regions
cd simulation_scripts
module load R
conda activate isolinesR
export OMP_NUM_THREADS=1

FULL_SAVE_PATH="/pscratch/sd/j/jbbutler/isolines/simulations/extremal_threeway_split/iso_boot_surv/gamma_0.67/C_15/twoC/"
DF_SAVE_PATH="~/isolines_uq/outputs/simulations/"

Rscript extremal_simulations_threeway_iso_boot_surv.R --save_full_path "$FULL_SAVE_PATH" --save_df_path "$DF_SAVE_PATH" --n_cores 64
